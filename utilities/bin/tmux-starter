#!/usr/bin/env bash

tmux new-session -s notes -c ~/Documents/notes/daily-activity-report -d
tmux send-keys -t notes "nvim DailyActivityReport" Enter

tmux new-session -s master -c ~/Documents/projects/DEP-Phase1/fe-library -d
tmux send-keys -t master "nvim" Enter
tmux split-window -v -l 33% -c ~/Documents/projects/DEP-Phase1/fe-library
tmux send-keys -t master "fnm use v16.20.2" Enter

tmux new-session -s develop -c ~/Documents/projects/MobileShoppingApp -d
tmux send-keys -t develop "nvim" Enter
tmux split-window -v -l 33% -c ~/Documents/projects/MobileShoppingApp
tmux send-keys -t develop "fnm use v22.14.0" Enter

tmux new-session -s dotfiles -c ~/dotfiles -d

tmux attach-session -t notes
